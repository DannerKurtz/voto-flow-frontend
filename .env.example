# Public backend URL used for REST and derived WebSocket connections.
NEXT_PUBLIC_API_URL=https://voto-flow-backend.onrender.com

# Official second-round disclosure start in Brasilia time.
NEXT_PUBLIC_RESULTS_START_AT=2026-10-25T17:00:00-03:00

# GA4 public measurement ID. Leave empty to disable analytics.
# Set only in the production environment, then rebuild/redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
